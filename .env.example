###############################################################################
# Investment OS - Environment Configuration
###############################################################################
#
# Copy this file to .env and customize for your environment.
#
# IMPORTANT:
#   - Do NOT commit .env to Git.
#   - Never put production secrets in this file.
#
###############################################################################
#  .env.example
#  │
#  ├── Application
#  ├── Server
#  ├── Database
#  ├── Redis
#  │
#  ├── LLM
#  │   ├── Provider
#  │   ├── Model
#  │   ├── Temperature
#  │   └── Max Tokens
#  │
#  ├── Qwen / CPU
#  │   ├── Model Path
#  │   ├── Context Size
#  │   └── Threads
#  │
#  ├── OpenAI
#  │   ├── API Key
#  │   └── Benchmark Model
#  │
#  ├── Logging
#  ├── Security / JWT
#  ├── Storage
#  └── Timezone
#  
###############################################################################
# Application
###############################################################################

APP_NAME=Investment OS
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false


###############################################################################
# Server
###############################################################################

HOST=0.0.0.0
PORT=8000

# Frontend is currently used by Docker/development tooling.
# Not consumed directly by app.core.config.Settings.
FRONTEND_PORT=3000


###############################################################################
# Database
###############################################################################

POSTGRES_DB=investment_os
POSTGRES_USER=investment
POSTGRES_PASSWORD=investment123

DATABASE_URL=postgresql+psycopg://investment:investment123@postgres:5432/investment_os

DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800


###############################################################################
# Redis
###############################################################################

REDIS_URL=redis://redis:6379/0


###############################################################################
# LLM
###############################################################################
#
# Default local/reference deployment:
#
#   Qwen3-8B Q4_K_M
#   llama.cpp
#   CPU-only
#
# Cloud quality benchmark:
#
#   OpenAI GPT-5.4 mini
#
# Supported providers:
#   qwen
#   openai
#   mock
#
###############################################################################

LLM_PROVIDER=qwen
LLM_MODEL=qwen3-8b-q4

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048


###############################################################################
# Qwen / Local CPU LLM
###############################################################################
#
# The GGUF model is NOT stored in the repository.
#
# Expected model:
#   Qwen3-8B-Q4_K_M.gguf
#
###############################################################################

QWEN_MODEL_PATH=/models/qwen3/Qwen3-8B-Q4_K_M.gguf
QWEN_CONTEXT_SIZE=8192
QWEN_THREADS=12


###############################################################################
# OpenAI / Cloud Benchmark
###############################################################################
#
# Optional.
#
# Used when:
#
#   LLM_PROVIDER=openai
#
# Never commit a real API key.
#
###############################################################################

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini


###############################################################################
# Logging
###############################################################################

LOG_LEVEL=INFO


###############################################################################
# Security / JWT
###############################################################################
#
# Development values only.
# Replace these before production deployment.
#
###############################################################################

JWT_SECRET_KEY=development-only-secret-key-change-before-production
JWT_ALGORITHM=HS256
JWT_ISSUER=investment-os

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30


###############################################################################
# Storage
###############################################################################

STORAGE_PROVIDER=local
STORAGE_ROOT=./storage

MAX_UPLOAD_SIZE=104857600


###############################################################################
# Timezone
###############################################################################
#
# Used by Docker/runtime infrastructure.
# Not currently a Settings field.
#
###############################################################################

TZ=Asia/Kolkata
